# Application Configuration
APP_NAME="Patch Priority Framework API"
APP_VERSION="1.0.0"
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security Configuration
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-replace-with-actual-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
# Examples:
# SQLite: sqlite:///./patch_priority.db
# PostgreSQL: postgresql://user:password@localhost/dbname
# MySQL: mysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./patch_priority.db

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# NVD API Configuration (for vulnerability data)
NVD_API_KEY=your-nvd-api-key-here-optional

# Logging Configuration
LOG_LEVEL=INFO
